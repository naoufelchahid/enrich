+        "G": ["M."],
+        "Prénom et Nom": ["Alice  Smith "],
+        "Fonction": ["Director"],
+        "TEL": ["0611223344"],
+        "E-mail": ["alice@acme.com"]
+    })
+    test_file = tmp_path / "BDD6.xls"
+    df.to_excel(test_file, index=False)
+    
+    with patch.object(pd, "read_excel", return_value=df):
