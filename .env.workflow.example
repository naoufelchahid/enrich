# Copy the missing entries into .env; keep existing provider credentials.
# Active storage uses the compact journal; mailing stays paused.
# Compact acquisitions require reviewed briefs with strict campaign/provider caps.
TWENTY_BASE_URL=http://localhost:3005
TWENTY_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=
TELEGRAM_CHAT_ID=
FULLENRICH_API_KEY=
NO2BOUNCE_API_KEY=
WORKFLOW_STAGING_PATH=bdd/workflow/staging.sqlite
WORKFLOW_BACKEND=compact
# Set to 1 for a test that stops before Telegram approval and all email sends.
WORKFLOW_STOP_AT_DRAFT=1
# Legacy: optional, defaults to <staging path>.journal.sqlite.
# Compact: REQUIRED explicit journal path; never append another journal suffix.
WORKFLOW_STATE_PATH=bdd/workflow/staging.sqlite.journal.sqlite
WORKFLOW_CODEX_BIN_DIR=
# Resume the existing Codex campaign thread after an authenticated Telegram
# message or approval. Requires the send_next_candidate cron tick.
TELEGRAM_AGENT_HOOK_ENABLED=0
TELEGRAM_AGENT_THREAD_ID=
THUNDERBIRD_CONNECTION_FILE=/home/naoufel/Downloads/thunderbird.tmp/thunderbird-mcp/connection.json
